 "doctype": "DocType",
 "engine": "InnoDB",
 "field_order": [
  "card_index",
  "header_format",
  "media_sample",
  "card_body",
  "button_type",
  "button_label",
  "website_url",
  "example_url",
  "phone_number",
  "button2_type",
  "button2_label",
  "button2_website_url",
  "button2_example_url",
  "button2_phone_number"
 ],
 "fields": [
  {
   "fieldname": "card_index",
   "fieldtype": "Int",
   "in_list_view": 1,
   "label": "Card Index",
   "read_only": 1
  },
  {
   "default": "PRODUCT",
   "description": "PRODUCT = Product Card Carousel (thumbnail from catalog). IMAGE/VIDEO = Media Card Carousel.",
   "fieldname": "header_format",
   "fieldtype": "Select",
   "in_list_view": 1,
   "label": "Header Format",
   "options": "PRODUCT\nIMAGE\nVIDEO"
  },
  {
   "depends_on": "eval:['IMAGE','VIDEO'].includes(doc.header_format)",
   "description": "Card image/video (Media Card Carousel only).",
   "fieldname": "media_sample",
   "fieldtype": "Data",
   "label": "Card Media"
  },
  {
   "depends_on": "eval:['IMAGE','VIDEO'].includes(doc.header_format)",
   "description": "Optional card body text. Max 160 characters. If any card has a body, all cards must.",
   "fieldname": "card_body",
   "fieldtype": "Small Text",
   "label": "Card Body"
  },
  {
   "default": "SPM",
   "fieldname": "button_type",
   "fieldtype": "Select",
   "in_list_view": 1,
   "label": "Button Type",
   "options": "SPM\nURL\nQuick Reply\nCall Phone",
   "reqd": 1
  },
  {
   "fieldname": "button_label",
   "fieldtype": "Data",
   "in_list_view": 1,
   "label": "Button Label"
  },
  {
   "depends_on": "eval:doc.button_type=='URL'",
   "description": "Max 2000 characters, supports one {{variable}}.",
   "fieldname": "website_url",
   "fieldtype": "Data",
   "label": "Website URL",
   "mandatory_depends_on": "eval:doc.button_type=='URL'"
  },
  {
   "depends_on": "eval:doc.button_type=='URL' && doc.website_url && doc.website_url.includes('{{')",
   "description": "Example value for the URL variable.",
   "fieldname": "example_url",
   "fieldtype": "Data",
   "label": "URL Variable Example"
  },
  {
   "depends_on": "eval:doc.button_type=='Call Phone'",
   "fieldname": "phone_number",
   "fieldtype": "Data",
   "label": "Phone Number",
   "mandatory_depends_on": "eval:doc.button_type=='Call Phone'"
  },
  {
   "description": "Optional second button (Media Card Carousel only).",
   "fieldname": "button2_type",
   "fieldtype": "Select",
   "label": "Second Button Type",
   "options": "\nURL\nQuick Reply\nCall Phone"
  },
  {
   "fieldname": "button2_label",
   "fieldtype": "Data",
   "label": "Second Button Label"
  },
  {
   "depends_on": "eval:doc.button2_type=='URL'",
   "fieldname": "button2_website_url",
   "fieldtype": "Data",
   "label": "Second Button Website URL"
  },
  {
   "depends_on": "eval:doc.button2_type=='URL' && doc.button2_website_url && doc.button2_website_url.includes('{{')",
   "fieldname": "button2_example_url",
   "fieldtype": "Data",
   "label": "Second Button URL Variable Example"
  },
  {
   "depends_on": "eval:doc.button2_type=='Call Phone'",
   "fieldname": "button2_phone_number",
   "fieldtype": "Data",
   "label": "Second Button Phone Number"
  }
 ],
